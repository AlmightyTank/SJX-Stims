<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>SJXStims</RootNamespace>
    <AssemblyName>AlmightyTank-SJXStims</AssemblyName>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <OutputType>Library</OutputType>
    <Version>1.0.0</Version>
    <!-- Produces a single, clean mod folder: bin\Release\SJX-Stims\ -->
    <OutputPath>bin\$(Configuration)\SJX-Stims\</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <!-- We include the data files explicitly below, so disable the Web SDK's implicit content globbing -->
    <EnableDefaultContentItems>false</EnableDefaultContentItems>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="SPTarkov.Common" Version="4.1.1" />
    <PackageReference Include="SPTarkov.DI" Version="4.1.1" />
    <PackageReference Include="SPTarkov.Server.Core" Version="4.1.1" />
  </ItemGroup>

  <!--
    Compile-time only reference to Consumables Galore for its LoadAdditionalItems
    extension point. Consumables Galore is a separate mod the player installs on
    their own, so its assembly must NOT be copied into this mod's output folder.
  -->
  <ItemGroup>
    <ProjectReference Include="..\ConsumablesGalore-Ported\ConsumablesGalore.csproj">
      <Private>false</Private>
      <ExcludeAssets>runtime;contentFiles</ExcludeAssets>
    </ProjectReference>
  </ItemGroup>

  <!-- Ship the data files alongside the compiled mod -->
  <ItemGroup>
    <Content Include="items\**\*.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
